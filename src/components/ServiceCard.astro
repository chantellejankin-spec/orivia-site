---
interface Props {
  href: string;
  title: string;
  summary: string;
}

const { href, title, summary } = Astro.props;
---

<a class="service-card reveal" href={href}>
  <h3>{title}</h3>
  <p>{summary}</p>
  <span class="more" aria-hidden="true">Learn more &rarr;</span>
</a>

<style>
  .service-card {
    display: block;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.85rem;
    height: 100%;
    background: rgba(255, 255, 255, 0.4);
    transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }

  .service-card:hover {
    border-color: var(--ink);
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.7);
  }

  .service-card h3 {
    margin-bottom: 0.5rem;
  }

  .service-card p {
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .more {
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
</style>
