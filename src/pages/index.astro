---
import Layout from '../layouts/Layout.astro';
import ImagePanel from '../components/ImagePanel.astro';

const principles = [
  {
    label: 'Ethical',
    text: 'Fair treatment of workers and communities is non-negotiable, in our own operations and in every mandate we advise on, from labour conditions to who a mineral is sourced through.',
    href: '/principles/ethical',
  },
  {
    label: 'Sustainable',
    text: 'Environmental stewardship and long-term viability guide how a site is run, so extraction strengthens the land and livelihoods it touches.',
    href: '/principles/sustainable',
  },
  {
    label: 'Traceable',
    text: 'Blockchain-based chain-of-custody tracks material from mine to market, giving investors, buyers and regulators verifiable answers about origin.',
    href: '/principles/traceable',
  },
  {
    label: 'Empowered',
    text: 'Local ownership, women’s participation and community-led decision-making sit at the centre of how we build and advise mining operations.',
    href: '/principles/empowered',
  },
];
---

<Layout title="Mining with Purpose">
  <section class="hero panel">
    <div class="panel-media">
      <img
        id="hero-img"
        src="/images/community-portrait.jpg"
        alt="Women from a mining community in Sub-Saharan Africa"
        loading="eager"
      />
    </div>
    <div class="panel-scrim"></div>
    <div class="panel-content">
      <div class="wrap">
        <h1 class="reveal">Mining with Purpose</h1>
        <p class="lede reveal">
          Orivia works across the full minerals supply chain, from
          artisanal operators to large-scale producers, explorers,
          investors, buyers and traders, across frontier markets with a
          focus on Sub-Saharan Africa. We also run our own ethical,
          small-scale mining operation.
        </p>
        <a class="pill-btn light reveal" href="#principles">Our Principles</a>
      </div>
    </div>
  </section>

  <section id="principles" class="section">
    <div class="wrap">
      <h2 class="reveal">What Ethical, Sustainable, Traceable and Empowered Mean Here</h2>
      <div class="principles-grid">
        {principles.map((p) => (
          <div class="principle reveal">
            <span class="label">{p.label}</span>
            <p>{p.text}</p>
            <a class="read-more" href={p.href}>Read more &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ImagePanel
    src="/images/aerial-landscape.jpg"
    alt="Aerial view of land shaped by artisanal mining and agriculture"
    eyebrow="About Orivia"
  >
    <h2 class="reveal">A Growing Mandate Across the Minerals Supply Chain</h2>
    <p class="reveal">
      What began as our own artisanal mining operation has grown into
      advisory work across every scale of the sector: other artisanal
      operators, mid-size and large-scale mining companies and
      explorers, investors, and the buyers and traders who move minerals
      to market, across frontier markets and especially Sub-Saharan
      Africa.
    </p>
    <a class="pill-btn light reveal" href="/about">Our Story</a>
  </ImagePanel>

  <section class="section what-we-do-teaser">
    <div class="wrap">
      <h2 class="reveal">Who We Work With</h2>
      <p class="intro reveal">
        Six vantage points across the minerals supply chain, at every
        scale, informed by the fact that we operate a mine ourselves.
      </p>
      <div class="audience-list">
        <a class="audience-row reveal" href="/what-we-do#mining-operations">
          <span>Our Own ASM Mining Operations</span><span class="arrow">&rarr;</span>
        </a>
        <a class="audience-row reveal" href="/what-we-do#asm-advisory">
          <span>Advisory for Artisanal &amp; Small-Scale Miners</span><span class="arrow">&rarr;</span>
        </a>
        <a class="audience-row reveal" href="/what-we-do#lsm-advisory">
          <span>Advisory for Large-Scale Mining &amp; Exploration Companies</span><span class="arrow">&rarr;</span>
        </a>
        <a class="audience-row reveal" href="/what-we-do#project-development">
          <span>Project Development: Land Access &amp; Stakeholder Facilitation</span><span class="arrow">&rarr;</span>
        </a>
        <a class="audience-row reveal" href="/what-we-do#investor-advisory">
          <span>Advisory for Investors</span><span class="arrow">&rarr;</span>
        </a>
        <a class="audience-row reveal" href="/what-we-do#buyer-trader-advisory">
          <span>Advisory for Buyers &amp; Traders</span><span class="arrow">&rarr;</span>
        </a>
      </div>
      <a class="pill-btn reveal" href="/what-we-do">See All of What We Do</a>
    </div>
  </section>

  <section class="section insights-teaser">
    <div class="wrap insights-grid">
      <div class="reveal">
        <h2>Insights</h2>
        <p>
          Background on artisanal mining, frontier markets and the
          practical realities of Sub-Saharan Africa&rsquo;s mining sector,
          grounded in operating experience.
        </p>
        <a class="pill-btn" href="/insights">Read Insights</a>
      </div>
      <div class="reveal">
        <h2>The Rough Nugget</h2>
        <p>
          Our weekly newsletter: gold and diamond prices, trends, and the
          industry news that matters, straight from the field.
        </p>
        <a class="pill-btn" href="/rough-nugget">Subscribe</a>
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap cta-inner reveal">
      <h2>Let&rsquo;s Talk About Your Project</h2>
      <p>
        Whether you operate a site, advise one, buy from the sector or are
        evaluating an investment in it, we&rsquo;d like to hear from you.
      </p>
      <a class="pill-btn" href="/contact">Connect</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    height: 92vh;
  }

  .lede {
    font-size: 1.15rem;
    max-width: 56ch;
    margin-bottom: 1.5rem;
  }

  .pill-btn.light {
    border-color: #f4f1e8;
    color: #f4f1e8;
  }

  .pill-btn.light:hover {
    background: #f4f1e8;
    color: var(--ink);
  }

  .intro {
    max-width: 640px;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .audience-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 2rem;
  }

  .audience-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    font-family: "Fraunces", serif;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    color: var(--ink);
    transition: padding-left 0.25s ease, color 0.25s ease;
  }

  .audience-list a:last-child {
    border-bottom: 1px solid var(--line);
  }

  .audience-row:hover {
    padding-left: 0.75rem;
    color: var(--ink-soft);
  }

  .arrow {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    transition: transform 0.25s ease;
  }

  .audience-row:hover .arrow {
    transform: translateX(4px);
  }

  .insights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }

  .cta {
    background: rgba(5, 40, 18, 0.05);
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-inner p {
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .insights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
